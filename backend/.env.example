# FastAPI Backend Environment Configurations

# Database connection URL (sqlite or postgresql)
# Example Postgres: postgresql://postgres_user:postgres_password@localhost:5432/campus_governance
DATABASE_URL=sqlite:///./campus_governance.db

# JWT Authentication Security Settings
# Generate a strong key in production using: openssl rand -hex 32
SECRET_KEY=your_cryptographic_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local folder path on the server for storing uploaded evidence files (images/PDFs)
UPLOAD_DIR=uploads

# xAI Grok / ChatGrok LLM Integration Settings
# Paste your Grok / ChatGrok developer key here:
GROK_API_KEY=
# Alternatively, support key name:
CHATGROK_API_KEY=

# Base URL endpoint for Grok API (Defaults to https://api.x.ai/v1)
GROK_API_URL=https://api.x.ai/v1

# Target model identifier (Defaults to grok-beta)
GROK_MODEL=grok-beta
