# =====================================================================
# CampusBridge FastAPI Backend Environment Configurations
# =====================================================================

# Database Connection URL
# Local SQLite format (default): sqlite:///./campus_governance.db
# PostgreSQL format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=sqlite:///./campus_governance.db

# JWT Authentication Security Settings
# Generate a strong key in production using: openssl rand -hex 32
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth Authentication
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Local folder path on the server for storing uploaded evidence files
UPLOAD_DIR=uploads

# xAI Grok / ChatGrok LLM Integration Settings
GROK_API_KEY=your_grok_api_key_here
CHATGROK_API_KEY=your_chatgrok_api_key_here

# Base URL endpoint for Grok API (Defaults to https://api.x.ai/v1)
GROK_API_URL=https://api.x.ai/v1

# Target model identifier (Defaults to grok-beta)
GROK_MODEL=grok-beta

# Realtime Gmail / SMTP Email Dispatcher Settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_NAME=CampusBridge Governance Portal
