# ==========================================
# CampusBridge Master Git Ignore Specification
# ==========================================

# Environment Variables & Secret Files (CRITICAL - DO NOT COMMIT SECRETS)
.env
.env.*
!.env.example
*.env
*.env.*
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Python & Virtual Environments
venv/
.venv/
backend/venv/
backend/.venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Database Files
*.db
*.sqlite
*.sqlite3
campus_governance.db

# Media Uploads & Temp Files
backend/uploads/*
!backend/uploads/.gitkeep

# Node & Next.js Build Artifacts
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
.next/
dist/

# TypeScript & Logs
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE, OS & System Files
.vscode/
.idea/
.DS_Store
Thumbs.db
.gemini/